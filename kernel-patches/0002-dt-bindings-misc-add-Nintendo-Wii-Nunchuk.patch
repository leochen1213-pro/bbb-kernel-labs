From d923f63f3720ce37bbee0ed08367e8f65b3cba1b Mon Sep 17 00:00:00 2001
From: Leo <leochen1213@gmail.com>
Date: Thu, 1 Oct 2026 19:38:12 +0800
Subject: [PATCH 2/3] dt-bindings: misc: add Nintendo Wii Nunchuk

---
 .../bindings/misc/nintendo,nunchuk.yaml       | 44 +++++++++++++++++++
 1 file changed, 44 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/misc/nintendo,nunchuk.yaml

diff --git a/Documentation/devicetree/bindings/misc/nintendo,nunchuk.yaml b/Documentation/devicetree/bindings/misc/nintendo,nunchuk.yaml
new file mode 100644
index 000000000000..4a4a7dcc2171
--- /dev/null
+++ b/Documentation/devicetree/bindings/misc/nintendo,nunchuk.yaml
@@ -0,0 +1,44 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/misc/nintendo,nunchuk.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Nintendo Wii Nunchuk
+
+maintainers:
+  - Leo <leo@example.com>
+
+description:
+  Nintendo Wii Nunchuk joystick extension, connected over I2C.
+  The device always answers at the fixed I2C address 0x52.
+
+properties:
+  compatible:
+    const: nintendo,nunchuk
+
+  reg:
+    maxItems: 1
+
+  nintendo,alternate-init:
+    type: boolean
+    description:
+      Use the alternate initialization sequence expected by some Nunchuks.
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        joystick@52 {
+            compatible = "nintendo,nunchuk";
+            reg = <0x52>;
+        };
+    };
-- 
