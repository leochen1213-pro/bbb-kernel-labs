From 00a7cf06db4dc59f2966f01644a5dad466379864 Mon Sep 17 00:00:00 2001
From: Leo <leochen1213@gmail.com>
Date: Sun, 11 Oct 2026 20:27:11 +0800
Subject: [PATCH] ARM: dts: am335x-boneblack-custom: wire LM75B OS pin to
 gpio1_28

Route the LM75B OS output (open-drain, active low) to P9_12 and
describe it as a level-low interrupt so the driver is notified when
the temperature crosses Tos/Thyst.

Signed-off-by: Leo <leochen1213@gmail.com>
---
 .../arm/boot/dts/ti/omap/am335x-boneblack-custom.dts | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/arch/arm/boot/dts/ti/omap/am335x-boneblack-custom.dts b/arch/arm/boot/dts/ti/omap/am335x-boneblack-custom.dts
index e150ceb31abf..6de837d7c95e 100644
--- a/arch/arm/boot/dts/ti/omap/am335x-boneblack-custom.dts
+++ b/arch/arm/boot/dts/ti/omap/am335x-boneblack-custom.dts
@@ -1,5 +1,6 @@
 // SPDX-License-Identifier: GPL-2.0
 #include "am335x-boneblack.dts"
+#include <dt-bindings/interrupt-controller/irq.h>
 
 / {
 	model = "BeagleBone Black - Leo custom";
@@ -20,6 +21,13 @@ AM33XX_PADCONF(AM335X_PIN_SPI0_D1, PIN_INPUT_PULLUP, MUX_MODE2)
 			AM33XX_PADCONF(AM335X_PIN_SPI0_CS0, PIN_INPUT_PULLUP, MUX_MODE2)
 		>;
 	};
+
+	lm75_os_pins: lm75-os-pins {
+		pinctrl-single,pins = <
+			/* P9_12: gpmc_ben1.gpio1_28, LM75 OS (open-drain, active low) */
+			AM33XX_PADCONF(AM335X_PIN_GPMC_BEN1, PIN_INPUT_PULLUP, MUX_MODE7)
+		>;
+	};
 };
 
 &i2c1 {
@@ -31,6 +39,10 @@ &i2c1 {
 	temperature-sensor@48 {
 		compatible = "national,lm75b";
 		reg = <0x48>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&lm75_os_pins>;
+		interrupt-parent = <&gpio1>;
+		interrupts = <28 IRQ_TYPE_LEVEL_LOW>;
 	};
 
 	joystick@52 {
-- 
2.43.0

