From 2efc1dab4b66611f9997e99333e6e88a79569c90 Mon Sep 17 00:00:00 2001
From: Leo <leochen1213@gmail.com>
Date: Mon, 19 Oct 2026 16:21:19 +0800
Subject: [PATCH 1/3] ARM: dts: am335x-boneblack-custom: disable HDMI audio

McASP0 and the simple-audio-card are not used. Disabling them frees the mcasp0_aclkx/fsx/axr0/ahclkr pads (P9_28-31) for SPI1, so the pins cannot be claimed twice if the audio drivers are ever loaded.

Signed-off-by: Leo <leochen1213@gmail.com>
---
 .../boot/dts/ti/omap/am335x-boneblack-custom.dts | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

diff --git a/arch/arm/boot/dts/ti/omap/am335x-boneblack-custom.dts b/arch/arm/boot/dts/ti/omap/am335x-boneblack-custom.dts
index c91b6d7472f8..692a6658b5b8 100644
--- a/arch/arm/boot/dts/ti/omap/am335x-boneblack-custom.dts
+++ b/arch/arm/boot/dts/ti/omap/am335x-boneblack-custom.dts
@@ -37,13 +37,8 @@ &i2c1 {
 	clock-frequency = <100000>;
 	
 	oled@3c {
-		compatible = "solomon,ssd1306";
+		compatible = "leo,ssd1306";
 		reg = <0x3c>;
-		solomon,width = <128>;
-		solomon,height = <32>;
-		solomon,page-offset = <0>;
-		solomon,com-seq;
-		solomon,com-invdir;
 	};
 	
 	temperature-sensor@48 {
@@ -100,3 +95,12 @@ &uart4 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&uart4_pins>;
 };
+
+/* HDMI audio is not used: free the McASP0 pads (P9_28-31) for SPI1 */
+&mcasp0 {
+	status = "disabled";
+};
+
+&{/sound} {
+	status = "disabled";
+};
-- 
